{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "ignoreCommand": "node -e \"const host = process.env.VERCEL_PROJECT_PRODUCTION_URL; process.exit(host && host !== 'coffe-edicion-abraham.vercel.app' ? 0 : 1)\"",
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=31536000" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/site.html",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" }
      ]
    }
  ],
  "redirects": [
    { "source": "/", "destination": "/site.html", "permanent": true }
  ],
  "functions": {
    "api/admin.js": { "includeFiles": "admin/index.html" }
  },
  "rewrites": [
    { "source": "/admin", "destination": "/api/admin" },
    { "source": "/admin/index.html", "destination": "/api/admin" }
  ]
}
